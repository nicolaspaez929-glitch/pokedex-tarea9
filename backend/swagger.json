{
  "openapi": "3.0.0",
  "info": {
    "title": "Pokémon Microservicio API",
    "version": "1.0.0",
    "description": "API para consultar datos de Pokémon desde Supabase o MongoDB"
  },
  "paths": {
    "/pokemon/{nombre}": {
      "get": {
        "summary": "Obtiene datos de un Pokémon",
        "parameters": [
          {
            "name": "nombre",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "mew"
          },
          {
            "name": "fuente",
            "in": "query",
            "required": false,
            "schema": { 
              "type": "string",
              "enum": ["supabase", "mongo"]
            },
            "example": "supabase"
          }
        ],
        "responses": {
          "200": { "description": "Éxito" },
          "404": { "description": "No encontrado" }
        }
      }
    }
  }
}
